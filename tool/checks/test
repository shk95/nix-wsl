#!/bin/sh
# Two tiers of verification, because they have different reach.
#
#   Tier 1 — eval.  Every configuration, from any host. Nix evaluates a
#                   configuration for a foreign system perfectly well; it just
#                   cannot realise one. This catches option typos, type
#                   errors, module assertions and bad imports — most of what
#                   actually breaks a config repo.
#   Tier 2 — build. Only where the target system is this machine. This is the
#                   part that proves the packages for that platform exist and
#                   the closure builds.
#
# `nix flake check` is neither: it validates the flake's shape and its standard
# outputs, and does not look inside homeConfigurations / darwinConfigurations /
# nixosConfigurations at all. A config repo that runs only `nix flake check` is
# not checking its configurations.
#
# What this cannot do is silently drop the gap. It prints a coverage block
# naming every configuration it could not build and why, plus any change in
# this branch whose blast radius reaches one of them. Paste that into the pull
# request — see decisions/003-done-must-be-mechanically-checkable.md, which
# already requires the body to carry what was *not* verified.

set -e

here=$(nix eval --raw --impure --expr 'builtins.currentSystem')

report=$(mktemp)
trap 'rm -f "$report"' EXIT

nix flake check

# The attribute that forces a real derivation, per flavour. Verified against
# all three: `pkgs.stdenv.hostPlatform.system` resolves the target system for
# every one of them, so the system probe below needs no special-casing.
toplevel_attr() {
  case $1 in
    homeConfigurations) echo "activationPackage" ;;
    *)                  echo "config.system.build.toplevel" ;;
  esac
}

check_flavour() {
  output=$1
  attr=$(toplevel_attr "$output")

  names=$(nix eval --raw ".#$output" \
    --apply 'x: builtins.concatStringsSep "\n" (builtins.attrNames x)' 2>/dev/null) || return 0
  [ -n "$names" ] || return 0

  echo "$names" | while IFS= read -r name; do
    [ -n "$name" ] || continue
    ref=".#$output.\"$name\""
    system=$(nix eval --raw "$ref.pkgs.stdenv.hostPlatform.system" 2>/dev/null || echo "unknown")

    printf '→ eval  %s.%s (%s)\n' "$output" "$name" "$system"
    if ! nix eval --raw "$ref.$attr.drvPath" >/dev/null; then
      printf '%s.%s|%s|FAIL|-\n' "$output" "$name" "$system" >> "$report"
      continue
    fi

    if [ "$system" != "$here" ]; then
      printf '%s.%s|%s|ok|skipped\n' "$output" "$name" "$system" >> "$report"
      continue
    fi

    printf '→ build %s.%s\n' "$output" "$name"
    if nix build --no-link "$ref.$attr"; then
      printf '%s.%s|%s|ok|ok\n' "$output" "$name" "$system" >> "$report"
    else
      printf '%s.%s|%s|ok|FAIL\n' "$output" "$name" "$system" >> "$report"
    fi
  done
}

check_flavour homeConfigurations
check_flavour darwinConfigurations
check_flavour nixosConfigurations

# ---------------------------------------------------------------------------
# Blast radius: which changes in this branch reach a configuration that was not
# built here.
#
# Deliberately crude — a directory-name rule, not a dependency graph. Anything
# not obviously platform-specific counts as shared, so a layout this rule has
# never been taught produces an over-warning rather than false confidence.
# `home/` is *not* treated as home-manager-only: a home-manager module is
# routinely imported by nix-darwin and NixOS too, and calling it covered would
# be exactly the wrong direction to be wrong in.
# ---------------------------------------------------------------------------

classify() {
  case $1 in
    darwin/*|*/darwin/*) echo darwinConfigurations ;;
    nixos/*|*/nixos/*)   echo nixosConfigurations ;;
    *)                   echo shared ;;
  esac
}

integration=${INTEGRATION_BRANCH:-dev}
changed=$(git diff --name-only "origin/$integration...HEAD" -- '*.nix' 'flake.lock' 2>/dev/null || true)

echo
echo "── Verification coverage ─────────────────────────────────"
printf '   host: %s\n\n' "$here"

while IFS='|' read -r target system evaled built; do
  case "$built" in
    ok)      note="build ✓" ;;
    skipped) note="build —  (needs $system)" ;;
    FAIL)    note="build ✗" ;;
    *)       note="build ?" ;;
  esac
  [ "$evaled" = "ok" ] && ev="eval ✓" || ev="eval ✗"
  printf '   %-38s %-8s %s\n' "$target" "$ev" "$note"
done < "$report"

# Configurations that were evaluated but not built, and which this branch
# actually touches. These are the ones to file — see
# decisions/005-unfinishable-work-becomes-an-issue.md.
if [ -z "$changed" ]; then
  printf '\n   · blast radius not computed: no origin/%s to diff against.\n' "$integration"
  printf '     Fetch it, or state the coverage by hand in the pull request.\n'
else
  grep '|skipped$' "$report" 2>/dev/null | while IFS='|' read -r target system _ _; do
    flavour=${target%%.*}
    hits=$(for f in $changed; do
             c=$(classify "$f")
             [ "$c" = "shared" ] || [ "$c" = "$flavour" ] && echo "     $f ($c)"
           done)
    [ -n "$hits" ] || continue
    printf '\n   ! %s was not built here, and this branch changes:\n' "$target"
    echo "$hits"
    printf '     Build it on %s, or file it:\n' "$system"
    # The full system string, not just "darwin": on x86_64-linux an
    # aarch64-linux configuration is equally unbuildable, and a label saying
    # "needs-linux" would read as satisfied by the host that just skipped it.
    printf '       gh issue create --label blocked --label blocked/needs-%s \\\n' "$system"
    printf '         --title "<what changed>: unbuilt on %s"\n' "$system"
  done
fi
echo

# Warnings do not fail the check. A shared module reaching an unbuildable host
# is the normal case in a multi-host config, and a gate that blocks every such
# push just teaches people --no-verify. Recording it is the control; the issue
# and the pull request body are where it is enforced.
if grep -q 'FAIL' "$report"; then
  printf '\033[31m✗ A configuration failed to evaluate or build.\033[0m\n' >&2
  exit 1
fi
